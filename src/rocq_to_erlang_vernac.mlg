{
open Stdarg
open Libnames

(* the parsing entry for a global reference, needed to define the
   [export_spec] argument below (coqpp refers to it unqualified) *)
let global = Procq.Constr.global
}

DECLARE PLUGIN "rocq-to-erlang"

{
open Pp
open Coreerlang

let pr_export_spec (x, e) =
  if e then pr_qualid x else str "noexport(" ++ pr_qualid x ++ str ")"
}

VERNAC ARGUMENT EXTEND export_spec
  PRINTED BY { pr_export_spec }
| [ "noexport" "(" global(x) ")" ] -> { (x, false) }
| [ global(x) ] -> { (x, true) }
END

(* Print the  Erlang extraction of a global reference to stdout.
   The reference may be marked [noexport(...)] to keep it out of the
   module exports (by default every listed reference is exported).
   Purely reads and prints: classified as QUERY. *)
VERNAC COMMAND EXTEND ErlangExtraction CLASSIFIED AS QUERY STATE opaque_access
| [ "Erlang" "Extraction" export_spec(x) ] -> { erlang_extraction x }
END

(* Monolithic extraction to a  Erlang file *)
VERNAC COMMAND EXTEND ErlangExtractionFile CLASSIFIED AS SIDEFF STATE opaque_access
| [ "Erlang" "Extraction" string(f) ne_export_spec_list(l) ]
  -> { erlang_extraction_file f l }
END

(* Separate extraction: no output file; the module (and file) name
   comes from the Rocq module of the extracted references *)
VERNAC COMMAND EXTEND ErlangSeparateExtraction CLASSIFIED AS SIDEFF STATE opaque_access
| [ "Erlang" "Separate" "Extraction" ne_export_spec_list(l) ]
  -> { erlang_extraction_separate l }
END

(* Declare a native call target for a Rocq definition: applications of
   the definition extract as calls to the Erlang function
   "module:function/arity"; the trailing integer counts leading Rocq
   arguments dropped untranslated (e.g. a typeclass dictionary), 0 if
   none. Declarations are recorded in the library (entries of a
   required theory apply here) and rolled back by Back. *)
VERNAC COMMAND EXTEND ErlangNativeCall CLASSIFIED AS SIDEFF
| [ "Erlang" "Native" "Call" global(r) ":=" string(s) integer(d) ]
  -> { erlang_native_call r s d }
END
