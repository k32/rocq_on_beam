{
open Extraction_plugin
open Stdarg
open Libnames

let global = Procq.Constr.global
}

DECLARE PLUGIN "rocq_on_beam"

{
open Erlang
}

VERNAC COMMAND EXTEND ErlangSimpleExtraction CLASSIFIED AS QUERY STATE opaque_access
| [ "Erlang" "Simple" "Extraction" global(r) ] -> { vernac_simple_extraction r }
END
