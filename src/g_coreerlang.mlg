{
open Stdarg
open Libnames

(* the parsing entry for a global reference, needed to define the
   [export_spec] argument below (coqpp refers to it unqualified) *)
let global = Procq.Constr.global
}

DECLARE PLUGIN "coreerlang_plugin"

{
open Pp
open Coreerlang

let pr_export_spec (x, e) =
  if e then pr_qualid x else str "noexport(" ++ pr_qualid x ++ str ")"
}

VERNAC ARGUMENT EXTEND export_spec
  PRINTED BY { pr_export_spec }
| [ "noexport" "(" global(x) ")" ] -> { (x, false) }
| [ global(x) ] -> { (x, true) }
END

{
}

VERNAC COMMAND EXTEND CoreErlangExtraction CLASSIFIED AS QUERY STATE opaque_access
(* Print the Core Erlang extraction of a global reference to stdout.
   The reference may be marked [noexport(...)] to keep it out of the
   module exports (by default every listed reference is exported). *)
| [ "CoreErlang" "Extraction" export_spec(x) ] -> { coreerlang_extraction x }
(* Monolithic extraction to a Core Erlang file *)
| [ "CoreErlang" "Extraction" string(f) ne_export_spec_list(l) ]
  -> { coreerlang_extraction_file f l }
END
